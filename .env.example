# Copy to .env for local development (`npm run dev`, `npm run worker:dev`,
# integration/smoke tests). In Docker Compose the values are set inline in
# docker-compose.yml. Nothing here is baked into the images.

# --- Database (Postgres / Prisma) - also backs the pg-boss job queue ---
DATABASE_URL='postgresql://mafftserver:mafftserver@localhost:5432/mafftserver'

# --- Job queue (pg-boss) ---
# Times a failed job is retried before it is marked failed.
# JOB_RETRY_LIMIT='2'
# Seconds before pg-boss treats an in-flight job as lost. Must stay above
# MAFFT_JOB_TIMEOUT_MS / 1000 (asserted at startup by src/lib/env.ts).
# JOB_EXPIRE_SECONDS='2700'
# pg-boss pool size per process; keep the sum across replicas under max_connections.
# PGBOSS_MAX_CONNECTIONS='5'

# --- MAFFT (worker) ---
# Path to the mafft entry point if it isn't on PATH.
# MAFFT_BIN='/usr/local/bin/mafft'
# Wall-clock cap on a single mafft run.
# MAFFT_JOB_TIMEOUT_MS='1800000'
# `--thread` passed to every run.
# MAFFT_WORKER_THREADS='4'
# Scratch space for running jobs (cleaned up after each job).
DATA_DIR='./data'

# --- Limits ---
# MAX_UPLOAD_BYTES='20971520'
# MAX_SEQUENCES='20000'
# MAX_RESULTS_ZIP_BYTES='209715200'

# --- App ---
# Sub-path when served behind a reverse proxy, e.g. '/mafft' for
# bioinformatics.nl/mafft. Build-time: changing it requires a rebuild.
# NEXT_PUBLIC_BASE_PATH=''
# Public URL used in notification emails - include the subpath.
# APP_URL='http://localhost:3000'

# --- Email notifications (optional; unset SMTP_HOST disables them) ---
# SMTP_HOST=''
# SMTP_PORT='587'
# SMTP_SECURE='false'
# SMTP_USER=''
# SMTP_PASS=''
# SMTP_FROM='mafftserver <no-reply@mafftserver.local>'
